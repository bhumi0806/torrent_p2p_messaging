# Copy this file to .env and fill in values locally.
# Never commit real secrets.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_MAX_REQUESTS=5
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=600
RATE_LIMIT_AUTH_ACCOUNT_MAX_REQUESTS=3
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=30
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2
RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=900
RATE_LIMIT_PUBLIC_IP_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_IP_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_ACCOUNT_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_ACCOUNT_WINDOW_SECONDS=60
RATE_LIMIT_AUTHENTICATED_IP_MAX_REQUESTS=300
RATE_LIMIT_AUTHENTICATED_IP_WINDOW_SECONDS=60
RATE_LIMIT_AUTHENTICATED_ACCOUNT_MAX_REQUESTS=300
RATE_LIMIT_AUTHENTICATED_ACCOUNT_WINDOW_SECONDS=60

# Client-side Vite values for testing across different networks.
# Put these VITE_* values in client/.env.local when running the Vite client from client/.
# Replace these with your own TURN service before real users depend on it.
VITE_BOOTSTRAP_URL=wss://your-bootstrap.example.com
VITE_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478","turns:turn.example.com:5349"],"username":"replace-me","credential":"replace-me"}]
# Use "relay" temporarily to prove TURN relay works across strict NATs.
VITE_ICE_TRANSPORT_POLICY=all
